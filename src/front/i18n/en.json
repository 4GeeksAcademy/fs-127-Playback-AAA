  "about": {
    "academy": {
      "cta": "View academy",
      "desc": "Developed as an MVP project for the full stack web development bootcamp. It represents the result of months of applied learning in a real and functional product.",
      "title": "Final project of",
      "visit": "Visit 4Geeks Academy"
    },
    "features": {
      "items": [
        {
          "desc": "Second-hand video games, consoles and accessories organised by categories and subcategories, with search and price filters.",
          "title": "Retro catalogue"
        },
        {
          "desc": "Persistent cart, Stripe checkout, shipment tracking, favourites, order history, reviews and PDF invoice download.",
          "title": "Complete buying experience"
        },
        {
          "desc": "Secure payments between buyers and sellers with configurable platform commission and automatic transfers to the seller.",
          "title": "Payments with Stripe Connect"
        },
        {
          "desc": "Product and incident images stored in Cloudinary. Avatars and logos auto-generated with UI Avatars on registration, with the option to update them manually.",
          "title": "Cloud images"
        },
        {
          "desc": "Transactional emails via Brevo (orders, shipments, cancellations). Ticket system with real-time chat and image attachments.",
          "title": "Emails and support tickets"
        },
        {
          "desc": "Interface in Spanish, English, Catalan and Galician. Products are automatically translated on publish. Light and dark mode.",
          "title": "4 languages and dark mode"
        },
        {
          "desc": "Sales statistics, product and multi-seller order management, Stripe Connect Express onboarding and low-stock alerts.",
          "title": "Seller dashboard"
        },
        {
          "desc": "Chatbot integrated with Groq API that helps buyers find products in the catalogue using natural language in real time.",
          "title": "AI-powered search assistant"
        }
      ],
      "title": "About the project"
    },
