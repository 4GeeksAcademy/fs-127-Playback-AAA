    "features": {
      "items": [
        {
          "desc": "Videoxogos, consolas e accesorios de segunda man organizados por categorías e subcategorías, con busca e filtros por prezo.",
          "title": "Catálogo retro"
        },
        {
          "desc": "Carriño persistente, checkout con Stripe, seguimento de envíos, favoritos, historial de pedidos, recensións e descarga de factura en PDF.",
          "title": "Experiencia de compra completa"
        },
        {
          "desc": "Pagamentos seguros entre compradores e vendedores con comisión de plataforma configurable e transferencias automáticas ao vendedor.",
          "title": "Pagamentos con Stripe Connect"
        },
        {
          "desc": "Imaxes de produtos e incidencias almacenadas en Cloudinary. Avatares e logos xerados automaticamente con UI Avatars ao rexistrarse, con opción de actualizalos manualmente.",
          "title": "Imaxes na nube"
        },
        {
          "desc": "Correos transaccionais vía Brevo (pedidos, envíos, cancelacións). Sistema de tickets con chat en tempo real e imaxes adxuntas.",
          "title": "Correos e tickets de soporte"
        },
        {
          "desc": "Interface en castelán, inglés, catalán e galego. Os produtos tradúcense automaticamente ao publicalos. Modo claro e escuro.",
          "title": "4 idiomas e modo escuro"
        },
        {
          "desc": "Estatísticas de vendas, xestión de produtos e pedidos multi-seller, onboarding con Stripe Connect Express e alertas de stock.",
          "title": "Panel de vendedor"
        },
        {
          "desc": "Chatbot integrado con Groq API que axuda aos compradores a atopar produtos no catálogo usando linguaxe natural.",
          "title": "Asistente de busca con IA"
        }
      ],
